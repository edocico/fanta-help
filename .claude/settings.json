{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/boundaries.sh\"",
            "timeout": 15,
            "statusMessage": "controllo i confini architetturali"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/untracked-guard.sh\"",
            "timeout": 15,
            "statusMessage": "cerco file nuovi che il commit non prenderebbe"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh\"",
            "timeout": 120,
            "statusMessage": "typecheck del progetto toccato"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/palette.sh\"",
            "timeout": 15,
            "statusMessage": "l'ambra è solo denaro"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/copy.sh\"",
            "timeout": 15,
            "statusMessage": "titoli in sentence case, mai maiuscolo spaziato"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/tabella.sh\"",
            "timeout": 15,
            "statusMessage": "le righe della tabella hanno tre pipe"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "electron-devtools"
  ]
}
