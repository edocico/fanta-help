{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/boundaries.sh\"",
            "timeout": 15,
            "statusMessage": "controllo i confini architetturali"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh\"",
            "timeout": 120,
            "statusMessage": "typecheck del progetto toccato"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "electron-devtools"
  ]
}
